{
  "name": "@reference-ui/reference-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "content-collections build --config src/collections/content-collections.ts && node ../reference-core/tools/ensure-dist.mjs && node ../reference-core/dist/bin/ref.js sync",
    "dev": "pnpm run sync && concurrently --kill-others --success first \"node ../reference-core/dist/bin/ref.js sync --watch\" \"vite\"",
    "build": "pnpm run sync && vite build",
    "build:pages": "pnpm build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "quality": "node tools/quality/run.mjs",
    "quality:test": "node --test tools/quality/*.test.mjs"
  },
  "dependencies": {
    "@reference-ui/lib": "workspace:*",
    "@reference-ui/core": "workspace:*",
    "@tanstack/react-router": "1.163.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.0",
    "@content-collections/vite": "^0.3.0",
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.1.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.5.0",
    "typescript": "~7.0.2",
    "vite": "^7.3.5",
    "zod": "^4.3.6"
  }
}
