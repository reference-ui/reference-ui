# Cargo build scratch (target-dir = "dist/cargo"; dist is gitignored at repo root,
# but kept explicit here so dist/cargo is never committed even if dist rules change)
dist/cargo/

# Node
node_modules/

# Tasty API loads emitted modules from scratch. Committed goldens live in output/.
# tests/.scratch is the legacy location, still ignored so old output never shows as untracked.
modules/tasty/.scratch/
modules/tasty/tests/.scratch/

# Generated ts-rs test bindings
bindings/

# Staging directories the JS build publishes from (dist.__stage-<pid>, dist.__decl-<pid>); removed on success, kept out of git if a build is killed.
dist.__*/
