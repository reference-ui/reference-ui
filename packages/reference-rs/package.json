{
  "name": "@reference-ui/rust",
  "version": "0.0.42",
  "private": false,
  "description": "Reference UI Rust and native bindings",
  "repository": {
    "type": "git",
    "url": "https://github.com/reference-ui/reference-ui",
    "directory": "packages/reference-rs"
  },
  "type": "module",
  "napi": {
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ],
    "binaryName": "virtual-native"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./tasty": {
      "types": "./dist/tasty.d.ts",
      "import": "./dist/tasty.mjs"
    },
    "./tasty/browser": {
      "types": "./dist/tasty/browser.d.ts",
      "import": "./dist/tasty/browser.mjs"
    },
    "./tasty/build": {
      "types": "./dist/tasty/build.d.ts",
      "import": "./dist/tasty/build.mjs"
    },
    "./atlas": {
      "types": "./dist/atlas.d.ts",
      "import": "./dist/atlas.mjs"
    },
    "./styletrace": {
      "types": "./dist/styletrace.d.ts",
      "import": "./dist/styletrace.mjs"
    },
    "./atomic": {
      "types": "./dist/atomic.d.ts",
      "import": "./dist/atomic.mjs"
    },
    "./system": {
      "types": "./dist/system.d.ts",
      "import": "./dist/system.mjs"
    }
  },
  "files": [
    "dist",
    "!dist/cargo",
    "!dist/artifacts",
    "!dist/npm",
    "README.md",
    "docs"
  ],
  "scripts": {
    "agentrs": "node ../../.agents/skills/agent-rs/scripts/run.mjs",
    "rs": "node ../../.agents/skills/agent-rs/scripts/run.mjs",
    "canon": "pnpm exec tsx ./modules/canon/generate/generate.ts",
    "artifacts": "pnpm exec napi artifacts --output-dir dist/artifacts --npm-dir dist/npm",
    "build": "pnpm run ensure-native && pnpm run build:js",
    "build:js": "tsup && tsc -p tsconfig.build.json && node ./modules/runtime/js/tools/create-dts-entrypoints.mjs",
    "build:native": "pnpm exec napi build --package reference-virtual-native --platform --release --output-dir dist/native --no-js",
    "create-npm-dirs": "pnpm exec napi create-npm-dirs --npm-dir dist/npm",
    "ensure-native": "pnpm exec tsx ./modules/runtime/js/tools/ensure-native.ts",
    "prepack": "pnpm run build:js",
    "prepublish:npm": "pnpm exec napi prepublish --no-gh-release -t npm --npm-dir dist/npm",
    "publish:native": "pnpm exec tsx ./modules/runtime/js/tools/publish-native.ts",
    "stage-local-artifacts": "pnpm exec tsx ./modules/runtime/js/tools/stage-local-artifacts.ts",
    "test": "pnpm run ensure-native && cargo test --workspace && vitest run",
    "test:rust": "cargo test --workspace --exclude reference-virtual-native",
    "test:vitest": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1",
    "@webref/css": "8.7.4",
    "@webref/elements": "2.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.0"
  }
}
