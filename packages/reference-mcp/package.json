{
  "name": "@reference-ui/mcp",
  "version": "0.0.1",
  "private": false,
  "description": "Project-aware and library-grounded MCP server for Reference UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/reference-ui/reference-ui",
    "directory": "packages/reference-mcp"
  },
  "type": "module",
  "bin": {
    "mcp": "./bin/mcp.mjs",
    "reference-mcp": "./bin/mcp.mjs",
    "ref-mcp": "./bin/mcp.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "instructions.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./dist/cli.mjs"
    }
  },
  "scripts": {
    "build:index": "node scripts/build-icons-index.mjs",
    "build": "node scripts/build-icons-index.mjs && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@reference-ui/core": "workspace:*",
    "@reference-ui/icons": "0.0.43",
    "@reference-ui/lib": "workspace:*",
    "@reference-ui/rust": "workspace:*",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.2",
    "minisearch": "^7.2.0",
    "picocolors": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "tsup": "^8.4.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.0"
  }
}
