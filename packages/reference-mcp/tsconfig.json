{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "resolveJsonModule": true,
    "paths": {
      "@reference-ui/styled": ["../reference-core/src/system/styled"],
      "@reference-ui/styled/*": ["../reference-core/src/system/styled/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
