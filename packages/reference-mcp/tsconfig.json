{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "resolveJsonModule": true,
    "paths": {
      "@reference-ui/core/config/store": ["../reference-core/src/config/store.ts"],
      "@reference-ui/core/config/errors": ["../reference-core/src/config/errors.ts"],
      "@reference-ui/core/config/evaluate": ["../reference-core/src/config/evaluate.ts"],
      "@reference-ui/core/config/validate": ["../reference-core/src/config/validate.ts"],
      "@reference-ui/core/config/constants": ["../reference-core/src/config/constants.ts"],
      "@reference-ui/core/config/types": ["../reference-core/src/config/types.ts"],
      "@reference-ui/core/reference": ["../reference-core/src/reference/api.ts"],
      "@reference-ui/core/fragments/runner": ["../reference-core/src/collect/lib/runner.ts"],
      "@reference-ui/core/fragments/scanner": ["../reference-core/src/collect/lib/scan/scanner.ts"],
      "@reference-ui/core/fragments/tokens": ["../reference-core/src/collect/surface/tokens.ts"],
      "@reference-ui/core/system/base/fragments": ["../reference-core/src/system/base/fragments.ts"],
      "@reference-ui/core/microbundle": ["../reference-core/src/lib/microbundle/index.ts"],
      "@reference-ui/core/style-vocabulary": ["../reference-core/src/native/style-vocabulary.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
