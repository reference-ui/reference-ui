{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "resolveJsonModule": true,
    "paths": {
      "@reference-ui/neo/config/store": ["../reference-neo/src/config/store.ts"],
      "@reference-ui/neo/config/errors": ["../reference-neo/src/config/errors.ts"],
      "@reference-ui/neo/config/evaluate": ["../reference-neo/src/config/evaluate.ts"],
      "@reference-ui/neo/config/validate": ["../reference-neo/src/config/validate.ts"],
      "@reference-ui/neo/config/constants": ["../reference-neo/src/config/constants.ts"],
      "@reference-ui/neo/config/types": ["../reference-neo/src/config/types.ts"],
      "@reference-ui/neo/reference": ["../reference-neo/src/reference/api.ts"],
      "@reference-ui/neo/fragments/runner": ["../reference-neo/src/collect/lib/runner.ts"],
      "@reference-ui/neo/fragments/scanner": ["../reference-neo/src/collect/lib/scan/scanner.ts"],
      "@reference-ui/neo/fragments/tokens": ["../reference-neo/src/collect/surface/tokens.ts"],
      "@reference-ui/neo/microbundle": ["../reference-neo/src/lib/microbundle/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
