{
  "name": "@reference-ui/lib",
  "version": "0.0.46",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/reference-ui/reference-ui",
    "directory": "packages/reference-lib"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./baseSystem": {
      "types": "./.reference-ui/system/baseSystem.d.mts",
      "import": "./.reference-ui/system/baseSystem.mjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs"
    },
    "./styles.css": "./dist/runtime/reference-ui/react/styles.css",
    "./primitives": {
      "types": "./dist/runtime/reference-ui/react/react.d.mts",
      "import": "./dist/runtime/reference-ui/react/react.mjs"
    }
  },
  "files": [
    "dist",
    ".reference-ui/system/baseSystem.d.mts",
    ".reference-ui/system/baseSystem.mjs",
    "README.md"
  ],
  "scripts": {
    "build:deps": "node ../../pipeline/scripts/run-if-env-absent.mjs REF_PIPELINE_SKIP_DEPENDENCY_BUILDS \"pnpm --filter @reference-ui/icons run build\"",
    "sync": "node ../reference-neo/tools/ensure-dist.mjs && node ../reference-neo/dist/bin/ref.js sync",
    "typecheck": "pnpm run build:deps && pnpm run sync && tsc --noEmit",
    "build": "pnpm run build:deps && pnpm run sync && node scripts/build-bundle.mjs --entry index=src/index.ts --entry theme/index=src/core/theme/index.ts --extra-external react-dom --extra-external @reference-ui/react --extra-external @reference-ui/styled --extra-external ./tasty/runtime.js --inline gsap && tsc -p tsconfig.build.json && node scripts/build-package.mjs",
    "dev": "node ./book/ensure-port.mjs && node ../reference-neo/tools/ensure-dist.mjs && node ../reference-neo/dist/bin/ref.js sync --quiet && concurrently --kill-others --success first --prefix none \"node ../reference-neo/dist/bin/ref.js sync --watch\" \"vite --config book/vite.config.ts\"",
    "book": "node ./book/ensure-port.mjs && vite --config book/vite.config.ts",
    "book:build": "vite build --config book/vite.config.ts",
    "prepack": "pnpm run build",
    "check:dist": "node scripts/check-dist-fresh.mjs",
    "smoke": "node scripts/consumer-smoke/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ct": "playwright test -c playwright/playwright.config.ts",
    "test:ct:ui": "playwright test -c playwright/playwright.config.ts --ui",
    "playbook": "pnpm run test:ct:ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reference-ui/icons": "0.0.43",
    "gsap": "^3.15.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
