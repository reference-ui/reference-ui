{
  "name": "@reference-ui/core",
  "version": "0.0.43",
  "private": false,
  "description": "Reference UI core",
  "repository": {
    "type": "git",
    "url": "https://github.com/reference-ui/reference-ui",
    "directory": "packages/reference-core"
  },
  "type": "module",
  "bin": {
    "ref": "./bin/ref.mjs",
    "mcp": "./bin/mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "tsconfig.json",
    "tools/copy-reference-api-component.mjs"
  ],
  "exports": {
    ".": {
      "types": "./src/public.ts",
      "import": "./dist/cli/public.mjs"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./dist/cli/config.mjs"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./dist/cli/constants.mjs"
    },
    "./paths": {
      "types": "./src/lib/paths/index.ts",
      "import": "./dist/cli/paths.mjs"
    },
    "./reference": {
      "types": "./src/reference/api.ts",
      "import": "./dist/cli/reference.mjs"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./dist/cli/tokens.mjs"
    }
  },
  "scripts": {
    "prepare": "node tools/copy-reference-api-component.mjs",
    "prebuild": "node tools/clean-dist.mjs && tsx src/system/primitives/generate/index.ts && tsx src/system/build/styled/index.ts && node tools/copy-reference-api-component.mjs",
    "build": "pnpm run build:native && tsup",
    "build:native": "node ../../pipeline/scripts/run-if-env-absent.mjs REF_PIPELINE_SKIP_DEPENDENCY_BUILDS \"pnpm --filter @reference-ui/rust run build\"",
    "prepack": "pnpm run build",
    "dev": "tsup --watch",
    "sync": "node dist/cli/index.mjs sync",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && vitest run",
    "test:watch": "vitest",
    "eslint:txt": "eslint . --format stylish --color"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": "^5.2.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@pandacss/dev": "^1.12.1",
    "@pandacss/node": "^1.12.1",
    "@pandacss/types": "^1.12.1",
    "@parcel/watcher": "^2.6.0",
    "@reference-ui/rust": "workspace:*",
    "@rspress/mdx-rs": "^0.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.2",
    "liquidjs": "^10.27.1",
    "picocolors": "^1.1.0",
    "picomatch": "^4.0.7",
    "piscina": "^5.3.2",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "symlink-dir": "^10.0.1",
    "tsdown": "^0.23.0",
    "tsup": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
