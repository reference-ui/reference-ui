{
  "mcpServers": {
    "reference-ui": {
      "command": "pnpm",
      "args": [
        "--filter",
        "@reference-ui/lib",
        "exec",
        "node",
        "../reference-core/bin/ref.mjs",
        "mcp"
      ],
      "cwd": "${workspaceFolder}"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
