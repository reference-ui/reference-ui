{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@reference-ui/styled": ["./.reference-ui/styled"],
      "@reference-ui/styled/*": ["./.reference-ui/styled/*"],
      "@reference-ui/system": ["./.reference-ui/system"],
      "@reference-ui/system/*": ["./.reference-ui/system/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
