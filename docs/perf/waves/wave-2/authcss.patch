+}
+
+/// True for a byte that always forces the slow path: quotes open preserved
+/// runs, structural bytes never render as themselves, and `0x85` / `0xA0`
+/// may be NEL/NBSP (a superset — unrelated multibyte tails only cost the
+/// slow path, never correctness).
+fn is_collapse_trigger(byte: u8) -> bool {
+    matches!(byte, b'"' | b'\'' | 0x09..=0x0D | 0x85 | 0xA0)
+}
