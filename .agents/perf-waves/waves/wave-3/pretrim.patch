 }
 
+// Pre-trim stored descriptions once at build so the query path performs
+// zero string surgery. MUST stay in sync with the readout contract:
+// searchDemand previously applied this exact trim per result.
+// Applied to _storedFields AFTER addAll so the inverted index (and hence
+// ranking) is built from full text and stays byte-identical.
+function trimDescription(desc, maxLen = 220) {
+  if (!desc || desc.length <= maxLen) return desc
+  const periodIdx = desc.indexOf('. ', 80)
+  if (periodIdx !== -1 && periodIdx <= maxLen) {
+    return desc.slice(0, periodIdx + 1)
+  }
+  const trimmed = desc.slice(0, maxLen)
+  const lastSpace = trimmed.lastIndexOf(' ')
+  return (lastSpace > 60 ? trimmed.slice(0, lastSpace) : trimmed) + '...'
+}
+
 async function main() {
