   console.log(`[build-icons-index] Reading icon metadata from ${metadataPath}...`)
@@ -81,6 +97,19 @@ async function main() {
 
   ms.addAll(docs)
 
+  // Trim the STORED field only; the inverted index keeps full text.
+  let trimmedCount = 0
+  for (const entry of ms._storedFields.values()) {
+    if (entry && typeof entry.description === 'string') {
+      const t = trimDescription(entry.description)
+      if (t !== entry.description) {
+        entry.description = t
+        trimmedCount++
+      }
+    }
+  }
+  console.log(`[build-icons-index] Pre-trimmed ${trimmedCount}/${docs.length} stored descriptions.`)
+
   // Serialize MiniSearch index
