+#[test]
+fn hoisted_base_matches_whole_string_path_on_system_prefixed_class() {
+    // System-style `__` class with plain + selector + at-rule atoms: pins the
+    // hoisted base end to end (base spelling, nesting, bucket order).
+    let rule = recipe_rule(
+        "bench-enterprise__tabs105__base",
+        vec![
+            conditioned_atom("color", "blue", "@media (min-width: 900px)"),
+            conditioned_atom("color", "green", "&:hover"),
+            plain_atom("color", "red"),
+            plain_atom("marginTop", "2r"),
+        ],
+    );
+    let css = emit_rule(&rule);
+    let base = css
+        .find(".bench-enterprise__tabs105__base { color: red; margin-top: 2r; }")
+        .expect("merged base rule");
+    let hover = css
+        .find(".bench-enterprise__tabs105__base:hover")
+        .expect("hover selector");
+    let media = css.find("@media (min-width: 900px)").expect("media wrap");
+    assert!(
+        base < hover && hover < media,
+        "base, selector, at-rule order:\n{css}"
+    );
+}
+
+#[test]
+fn escaped_base_pins_leading_digit_and_scope_chars() {
+    assert_eq!(
+        super::escaped_base_selector("2xl:card__base"),
+        ".\\32 xl\\:card__base"
+    );
+    assert_eq!(
+        super::escaped_base_selector("@scope/pkg__card"),
+        ".\\@scope\\/pkg__card"
+    );
+    // Unconditioned atoms return the base unchanged through the nest loop.
+    let atom = plain_atom("color", "red");
+    assert_eq!(
+        super::recipe_selector_from_base(".bench-enterprise__x", &atom),
+        ".bench-enterprise__x"
+    );
+}
