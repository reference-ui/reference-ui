{
  "name": "@reference-ui/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Reference UI - Knowledge-First Components",
  "repository": {
    "type": "git",
    "url": "https://github.com/reference-ui/reference-ui"
  },
  "scripts": {
    "setup:local": "bash ./pipeline/setup/local.sh",
    "pipeline": "pnpm --dir pipeline exec tsx src/cli.ts",
    "dev": "pnpm dev:docs",
    "dev:docs": "pnpm --filter @reference-ui/reference-docs run dev",
    "dev:lib": "pnpm --filter @reference-ui/lib run dev",
    "test:lib": "pnpm agentct",
    "capture": "node .agents/skills/tweak-component/scripts/capture.mjs",
    "capture:states": "node .agents/skills/tweak-component/scripts/capture.mjs --states",
    "agentct": "node .agents/skills/test-component/scripts/test-component.mjs",
    "ct": "node .agents/skills/test-component/scripts/test-component.mjs",
    "playbook": "pnpm --filter @reference-ui/lib run playbook",
    "changeset": "changeset",
    "release": "pnpm pipeline release",
    "agent": "node .agents/skills/test-core/scripts/run.mjs",
    "agent:pw": "node .agents/skills/test-core/scripts/run.mjs playwright",
    "agent:vitest": "node .agents/skills/test-core/scripts/run.mjs vitest",
    "pipeline:fast": "node .agents/skills/test-core/scripts/run.mjs test",
    "pipeline:test:matrix": "node .agents/skills/test-core/scripts/run.mjs test:matrix",
    "pipeline:verify:all": "node .agents/skills/test-core/scripts/run.mjs verify:all"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@swc-node/register": "~1.12.1",
    "@swc/core": "~1.16.2",
    "@swc/helpers": "~0.5.23",
    "@types/node": "^26.5.1",
    "nx": "^22.4.4",
    "prettier": "~3.9.6",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@10.29.3"
}
